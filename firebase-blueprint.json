{
  "entities": {
    "QuizResult": {
      "title": "QuizResult",
      "description": "초등학생 일상생활 영단어 퀴즈 제출 결과 데이터",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID (익명 로그인 사용자 ID)"
        },
        "classRoom": {
          "type": "string",
          "description": "학급 (반)",
          "maxLength": 20
        },
        "studentNumber": {
          "type": "number",
          "description": "학생 번호"
        },
        "studentName": {
          "type": "string",
          "description": "학생 이름",
          "maxLength": 50
        },
        "score": {
          "type": "number",
          "description": "퀴즈 총점 (100점 만점)"
        },
        "correctCount": {
          "type": "number",
          "description": "정답 개수 (0~20)"
        },
        "totalQuestions": {
          "type": "number",
          "description": "총 문항 수 (20)"
        },
        "answers": {
          "type": "array",
          "description": "각 20개 문항별 학생 답안 내역"
        },
        "submittedAt": {
          "type": "string",
          "description": "제출 시각 ISO 문자열",
          "maxLength": 40
        }
      },
      "required": [
        "userId",
        "classRoom",
        "studentNumber",
        "studentName",
        "score",
        "correctCount",
        "totalQuestions",
        "answers",
        "submittedAt"
      ]
    }
  },
  "firestore": {
    "/quiz_results/{resultId}": {
      "schema": {
        "$ref": "#/entities/QuizResult"
      },
      "description": "초등학생들이 제출한 영단어 퀴즈 결과 컬렉션"
    }
  }
}
